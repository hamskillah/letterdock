# =====================================================================
# Letterdock Sovereign Email Infrastructure - Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Core Security & Authentication
# ---------------------------------------------------------------------
# Sovereign operator password for web console login (min 16 chars recommended)
ADMIN_PASSWORD=change-me-to-a-secure-admin-password

# Session signature secret for signed cookies (min 32 chars required)
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars-long

# Master encryption key for AES-256-GCM encrypted secrets (min 32 chars or 64-char hex)
# If omitted, falls back to SESSION_SECRET derivation with a warning.
APP_ENCRYPTION_KEY=change-me-to-a-secure-32-byte-hex-or-string-key

# ---------------------------------------------------------------------
# 2. Database & Port Configuration
# ---------------------------------------------------------------------
# Postgres password for Docker Compose database service
POSTGRES_PASSWORD=letterdock_secure_db_pass_123

# Host port for web operator dashboard and API (default: 3000)
APP_PORT=3000

# Optional: Full database connection string (used when running outside compose)
# DATABASE_URL=postgres://letterdock:letterdock_secure_db_pass_123@127.0.0.1:5432/letterdock

# Exact public origin for CSRF enforcement (e.g., https://mail.yourdomain.com)
# Defaults to http://localhost:<APP_PORT> if unset.
PUBLIC_URL=

# ---------------------------------------------------------------------
# 3. Hybrid Storage Architecture (Local FS or S3 / Cloudflare R2)
# ---------------------------------------------------------------------
# Storage driver: "fs" (local filesystem) or "s3" (Cloudflare R2, AWS S3, MinIO)
STORAGE_DRIVER=fs

# Directory path when STORAGE_DRIVER=fs (default: ./data/storage)
STORAGE_PATH=./data/storage

# S3 / R2 Configuration (required only when STORAGE_DRIVER=s3)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------
# 4. Outbound Email Relay (SMTP / Resend Relay)
# ---------------------------------------------------------------------
# Default provider for outbound email: "smtp", "resend", or "mock"
OUTBOUND_PROVIDER=smtp

# SMTP Relay Configuration (when OUTBOUND_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your-smtp-relay-password

# Resend Relay Configuration (when OUTBOUND_PROVIDER=resend)
RESEND_API_KEY=

# ---------------------------------------------------------------------
# 5. Background Worker Pool & Concurrency
# ---------------------------------------------------------------------
# Number of concurrent job processing workers (default: 3)
WORKER_CONCURRENCY=3

# ---------------------------------------------------------------------
# 6. Cloudflare Email Routing & Staging Ingress (Optional)
# ---------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMAIL_WORKER=
R2_BUCKET=
R2_ENDPOINT=

DOMAIN_CONNECT_KEY_FILE=
DOMAIN_CONNECT_PROVIDER_ID=tokenhouse.site

# ---------------------------------------------------------------------
# 7. Inbound Safety & Storage Quota Limits (in bytes)
# ---------------------------------------------------------------------
INBOUND_DOMAIN_DAILY_BYTES=536870912
INBOUND_DATABASE_BYTES=10737418240
INBOUND_MIN_FREE_BYTES=1073741824

# ---------------------------------------------------------------------
# 8. Tailscale & Network Interface Binding
# ---------------------------------------------------------------------
# Set BIND_ADDRESS to 100.x.y.z (Tailscale IP) or 0.0.0.0 for direct network access.
# Defaults to 127.0.0.1 (local loopback only).
BIND_ADDRESS=127.0.0.1

# Enable Tailscale origin and CSRF authorization (can also be toggled in UI)
TAILSCALE_ENABLED=false
# Optional explicit Tailscale origin or MagicDNS domain
# TAILSCALE_ORIGIN=https://letterdock.your-tailnet.ts.net
# Mode: serve | direct | sidecar | custom
TAILSCALE_MODE=serve
